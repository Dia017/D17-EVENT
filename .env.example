# Port du serveur (fourni automatiquement par la plupart des hébergeurs)
PORT=3000

# Adresse d'origine autorisée à appeler l'API (l'URL de votre site une fois en ligne)
# Exemple : https://d17events.com — laissez vide en local pour tout autoriser
CORS_ORIGIN=

# --- Configuration e-mail (SMTP) ---
# Avec Gmail : activez la validation en 2 étapes puis créez un "mot de passe d'application"
# (myaccount.google.com/apppasswords). N'utilisez jamais votre mot de passe Gmail normal ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application
FROM_EMAIL=votre-adresse@gmail.com
